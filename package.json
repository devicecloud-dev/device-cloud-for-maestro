{
  "name": "dcd-github-action",
  "description": "run maestro tests on devicecloud.dev",
  "author": "devicecloud.dev",
  "version": "2.6.0",
  "main": "src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "ncc build",
    "test": "vitest run",
    "test:gha": "pnpm run build && cp -r dist ../test-gha/gha && cp action.yml ../test-gha/gha"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=8.10.2",
      "postcss": ">=8.5.18"
    }
  },
  "packageManager": "pnpm@10.29.3"
}
