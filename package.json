{
  "name": "dcd-github-action",
  "description": "run maestro tests on devicecloud.dev",
  "author": "devicecloud.dev",
  "version": "2.3.0",
  "main": "src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "ncc build",
    "test": "vitest run",
    "test:gha": "pnpm run build && cp -r dist ../test-gha/gha && cp action.yml ../test-gha/gha"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=8.9.0",
      "postcss": ">=8.5.18"
    }
  },
  "packageManager": "pnpm@10.29.3"
}
